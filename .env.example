# Copy this file to .env and fill in your real values.
# .env is where the server reads email credentials from — never commit
# your actual .env file (with real passwords) to version control.

# --- Where the alert email goes ---
CLINIC_EMAIL=frontdesk@brightsidedental.example

# --- SMTP server that will send the email ---
# Example values below are for Gmail. See setup notes further down.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-clinic-inbox@gmail.com
SMTP_PASS=your-16-character-app-password

# --- Optional: what recipients see as the "From" address ---
# Defaults to SMTP_USER if not set.
FROM_EMAIL=your-clinic-inbox@gmail.com

# =========================================================
# SETUP NOTES
# =========================================================
#
# Option A — Gmail (easiest to start with, fine for low volume):
#   1. Turn on 2-Step Verification on the Google account you'll send from:
#      https://myaccount.google.com/security
#   2. Create an "App Password": https://myaccount.google.com/apppasswords
#      (choose "Mail" as the app) — copy the 16-character password.
#   3. Use that app password as SMTP_PASS above (not your normal Gmail password).
#
# Option B — A transactional email provider (better for a real clinic,
# higher sending limits, better deliverability):
#   - Resend, SendGrid, Postmark, or Mailgun all offer free tiers and give
#     you SMTP credentials (host/port/user/pass) on their dashboard —
#     drop those values in above instead of Gmail's.
#
# After setting this up, restart the server. If email alerts aren't
# configured, the server will still work — bookings still save — it'll
# just log a warning instead of sending an email.
